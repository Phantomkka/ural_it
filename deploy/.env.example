NETCITY_PROJECT_NAME=netcity-online
# Domain without a URL scheme enables automatic HTTPS. localhost uses a local CA.
# For initial HTTP-only IP testing set NETCITY_SITE=:80.
NETCITY_SITE=localhost
NETCITY_BIND=127.0.0.1
NETCITY_HTTP_PORT=18080
NETCITY_HTTPS_PORT=18443
NETCITY_RELEASE=local
NETCITY_UID=1000
NETCITY_GID=1000
POSTGRES_USER=netcity
POSTGRES_DB=netcity
# Absolute path to an untracked mode-0600 secret owned by NETCITY_UID.
NETCITY_SECRET_FILE=/absolute/path/to/postgres_password
NETCITY_DB_MEMORY=512m
NETCITY_SERVER_MEMORY=512m
NETCITY_CLIENT_MEMORY=256m
