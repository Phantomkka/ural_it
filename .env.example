# Leave DATABASE_URL empty for explicitly labelled temporary profiles.
DATABASE_URL=
POSTGRES_DB=netcity
POSTGRES_USER=netcity
# Generate a local secret; never commit .env.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# For PostgreSQL set DATABASE_URL=postgresql://netcity:YOUR_GENERATED_PASSWORD@127.0.0.1:5432/netcity
